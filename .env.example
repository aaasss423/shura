# Optional Telegram delivery. Never commit real credentials.
SHURA_TELEGRAM_TOKEN=
SHURA_TELEGRAM_CHAT_ID=
SHURA_STATE_DB=shura.db
SHURA_REPO_DIR=repo
SHURA_MAX_SOURCES=250
# GitHub search API token is optional; keep it in the runtime environment.
GITHUB_TOKEN=
# Live network tests are skipped unless explicitly enabled.
SHURA_REAL_NETWORK=0
SHURA_LIVE_TEST_URL=
