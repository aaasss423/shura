# Client-facing published artifacts are committed so Mihon can fetch them over
# raw.githubusercontent / Pages: repo.json, index.json/index.min.json, index.pb,
# index.shura.json and apk/*.apk. Runtime state (store *.db, /artifacts/) and
# stale top-level copies at repo/ root stay ignored.
!repo/index.json
!repo/index.min.json
!repo/index.pb
!repo/repo.json
!repo/apk/
!repo/apk/*.apk

# Deferred Pro-chan harness. It is a port of ProComicImageInterceptor v1.5.1 and
# imports PIL, which is deliberately not a project dependency (pyproject keeps
# dependencies = [] and CI installs nothing). Committed as-is it fails
# `python -m unittest discover -s tests` on a clean runner with
# ModuleNotFoundError: No module named 'PIL'. It stays out of version control
# until the Pro-chan phase either declares Pillow in CI or gates the harness on
# it. Do not sweep this in with `git add -A`.
tests/test_protected_tile_decode.py

/artifacts/