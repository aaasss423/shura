[
  { "id": "en-h-01", "source_language": "en", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "Yes, sir. Right away.", "reference_arabic": "نعم سيدي. حالًا.", "context": "Military deferential address; must not read as casual.", "series": "fixture-en", "chapter": 1, "character": "soldier" },
  { "id": "en-h-02", "source_language": "en", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "Your Majesty, the court is waiting.", "reference_arabic": "جلالتكم، البلاط في انتظاركم.", "context": "Royal address in a fantasy setting.", "series": "fixture-en", "chapter": 1, "character": "king" },
  { "id": "en-h-03", "source_language": "en", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "dev", "source_text": "Don't call me that. I'm Hayaku.", "reference_arabic": "لا تنادني بذلك. أنا هاياكو.", "context": "Rejecting an address; tests that honorifics are not applied mechanically.", "series": "fixture-en", "chapter": 1, "character": "hayaku" },
  { "id": "en-h-04", "source_language": "en", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "test", "source_text": "Officer, we've got a problem.", "reference_arabic": "أيها الضابط، لدينا مشكلة.", "context": "Rank address in dialogue.", "series": "fixture-en", "chapter": 3, "character": "officer" },
  { "id": "en-h-05", "source_language": "en", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "test", "source_text": "I am nobody's senior.", "reference_arabic": "لست سنباي لأحد.", "context": "Borrowed honorific inside English; tests transliteration vs meaning.", "series": "fixture-en", "chapter": 3 },

  { "id": "en-d-01", "source_language": "en", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "Are you serious right now?!", "reference_arabic": "هل أنت جاد الآن؟", "context": "The most common single manga bubble shape.", "series": "fixture-en", "chapter": 1 },
  { "id": "en-d-02", "source_language": "en", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "I almost died back there.", "reference_arabic": "كدت أموت هناك.", "context": "Near-death past tense.", "series": "fixture-en", "chapter": 1 },
  { "id": "en-d-03", "source_language": "en", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "Don't worry, I'll be fine.", "reference_arabic": "لا تقلق، سأكون بخير.", "context": "Reassurance; register must stay light.", "series": "fixture-en", "chapter": 1 },
  { "id": "en-d-04", "source_language": "en", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "My father was fine yesterday.", "reference_arabic": "كان والدي بخير بالأمس.", "context": "Quiet grief; restrained register.", "series": "fixture-en", "chapter": 2 },
  { "id": "en-d-05", "source_language": "en", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "I don't believe what you just said to me.", "reference_arabic": "لا أصدق ما قلته لي للتو.", "context": "Emotive first-person reaction.", "series": "fixture-en", "chapter": 3 },
  { "id": "en-d-06", "source_language": "en", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "Minimum height 165 cm, age 18.", "reference_arabic": "الحد الأدنى للطول 165 سم، العمر 18.", "context": "Numbers and units; tests that digits survive.", "series": "fixture-en", "chapter": 3 },

  { "id": "en-c-01", "source_language": "en", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "Come on, don't be like that.", "reference_arabic": "يا إلهي، لا تكن هكذا.", "context": "Casual exasperation.", "series": "fixture-en", "chapter": 1 },
  { "id": "en-c-02", "source_language": "en", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "I never said that.", "reference_arabic": "لم أقل ذلك قط.", "context": "Casual denial with an intensifier.", "series": "fixture-en", "chapter": 2 },
  { "id": "en-c-03", "source_language": "en", "target_language": "ar", "category": "colloquial", "difficulty": "easy", "split": "test", "source_text": "Hold on a second.", "reference_arabic": "لحظة من فضلك.", "context": "Casual request to wait.", "series": "fixture-en", "chapter": 3 },
  { "id": "en-c-04", "source_language": "en", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "test", "source_text": "Just forget it.", "reference_arabic": "انسَ الأمر ببساطة.", "context": "Casual dismissal.", "series": "fixture-en", "chapter": 3 },

  { "id": "en-s-01", "source_language": "en", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "That's insane, no way.", "reference_arabic": "هذا جنون، مستحيل.", "context": "Casual gamer reaction; the intensifier must survive.", "series": "fixture-en", "chapter": 2 },
  { "id": "en-s-02", "source_language": "en", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "I'm straight-up done with this.", "reference_arabic": "أنهيت حقًا مع هذا.", "context": "A-American slang; must not be translated word by word.", "series": "fixture-en", "chapter": 2 },
  { "id": "en-s-03", "source_language": "en", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "No cap, that was brutal.", "reference_arabic": "بلا مبالغة، كان قاسيًا.", "context": "Gen-Z slang intensifier.", "series": "fixture-en", "chapter": 4 },
  { "id": "en-s-04", "source_language": "en", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "It slaps, fr.", "reference_arabic": "يعجبني كثيرًا، بجد.", "context": "Very casual slang with an intensifier.", "series": "fixture-en", "chapter": 4 },

  { "id": "en-i-01", "source_language": "en", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "I'm dead if I open that door.", "reference_arabic": "سأموت إن فتحت ذلك الباب.", "context": "Slang idiom: 'dead' is emphatic, not literal.", "series": "fixture-en", "chapter": 2 },
  { "id": "en-i-02", "source_language": "en", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "That's a can of worms.", "reference_arabic": "هذه فوضى كبيرة.", "context": "Idiom about a complicated situation.", "series": "fixture-en", "chapter": 3 },
  { "id": "en-i-03", "source_language": "en", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "test", "source_text": "He kicked the bucket last winter.", "reference_arabic": "توفي الشتاء الماضي.", "context": "Euphemism for death; tests whether the euphemism survives.", "series": "fixture-en", "chapter": 5 },
  { "id": "en-i-04", "source_language": "en", "target_language": "ar", "category": "idiom", "difficulty": "medium", "split": "test", "source_text": "Don't beat around the bush.", "reference_arabic": "لا تلف وتدور.", "context": "Idiom about being direct.", "series": "fixture-en", "chapter": 5 },

  { "id": "en-n-01", "source_language": "en", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "dev", "source_text": "Kurosaki said nothing.", "reference_arabic": "لم يقل كوروساكي شيئًا.", "context": "Surname must stay a name, not be translated.", "series": "fixture-en", "chapter": 1, "character": "kurosaki" },
  { "id": "en-n-02", "source_language": "en", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "dev", "source_text": "Yumi and Hana were talking.", "reference_arabic": "كان يومي وهانا يتحدثان.", "context": "Two given names in one panel.", "series": "fixture-en", "chapter": 2, "character": "yumi" },
  { "id": "en-n-03", "source_language": "en", "target_language": "ar", "category": "name", "difficulty": "hard", "split": "test", "source_text": "Anna looked at Kenji and said nothing.", "reference_arabic": "نظرت آنا إلى كينجي ولم تقل شيئًا.", "context": "Two names plus two clauses; tests both naming and alignment.", "series": "fixture-en", "chapter": 6, "character": "anna" },
  { "id": "en-n-04", "source_language": "en", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "test", "source_text": "We'll meet at the Kyoto tower tomorrow.", "reference_arabic": "غدًا، نلتقي عند برج كيوتو.", "context": "Place name inside a narrative clause.", "series": "fixture-en", "chapter": 6 },

  { "id": "en-p-01", "source_language": "en", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "dev", "source_text": "The old town is still quiet.", "reference_arabic": "الحي القديم ما زال هادئًا.", "context": "Place description; tests narrative register.", "series": "fixture-en", "chapter": 3 },
  { "id": "en-p-02", "source_language": "en", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "test", "source_text": "We waited for the rain to stop in Osaka.", "reference_arabic": "انتظرنا توقف المطر في أوساكا.", "context": "City name inside a narrative clause.", "series": "fixture-en", "chapter": 5 },

  { "id": "en-f-01", "source_language": "en", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "dev", "source_text": "BANG!", "reference_arabic": "دُمْ!", "context": "Impact SFX as a standalone panel.", "series": "fixture-en", "chapter": 2 },
  { "id": "en-f-02", "source_language": "en", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "dev", "source_text": "CRACK", "reference_arabic": "طَقْ.", "context": "Snap SFX, hand-lettered.", "series": "fixture-en", "chapter": 2 },
  { "id": "en-f-03", "source_language": "en", "target_language": "ar", "category": "sound_effect", "difficulty": "hard", "split": "test", "source_text": "FWOOOSH", "reference_arabic": "وَوووم.", "context": "Whoosh SFX; elongation must not become noise.", "series": "fixture-en", "chapter": 5 },
  { "id": "en-f-04", "source_language": "en", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "test", "source_text": "click", "reference_arabic": "طَقْ.", "context": "Lowercase click SFX; tests case-insensitive handling.", "series": "fixture-en", "chapter": 5 },

  { "id": "en-x-01", "source_language": "en", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "No.", "reference_arabic": "لا.", "context": "Single-word rejection bubble.", "series": "fixture-en", "chapter": 1 },
  { "id": "en-x-02", "source_language": "en", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "Stop!", "reference_arabic": "قف!", "context": "Single-word command bubble.", "series": "fixture-en", "chapter": 1 },
  { "id": "en-x-03", "source_language": "en", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "He's here.", "reference_arabic": "إنه هنا.", "context": "Short present statement; tense matters.", "series": "fixture-en", "chapter": 5 },
  { "id": "en-x-04", "source_language": "en", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "You heard that?", "reference_arabic": "سمعت ذلك؟", "context": "Short question bubble.", "series": "fixture-en", "chapter": 5 },

  { "id": "en-l-01", "source_language": "en", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "dev", "source_text": "She didn't say anything that day; she just stood at the door for a long time.", "reference_arabic": "لم تقل شيئًا في ذلك اليوم؛ بل وقفت عند الباب طويلًا.", "context": "Long narrative sentence with a semicolon clause.", "series": "fixture-en", "chapter": 3 },
  { "id": "en-l-02", "source_language": "en", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "dev", "source_text": "Nobody helped him, and he never asked anyone for help.", "reference_arabic": "لم يساعده أحد، ولم يطلب المساعدة من أحد.", "context": "Long parallel sentence; tests clause alignment.", "series": "fixture-en", "chapter": 3 },
  { "id": "en-l-03", "source_language": "en", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "test", "source_text": "The rain stopped at midnight, but not one light on the street had gone out.", "reference_arabic": "توقف المطر عند منتصف الليل، لكن لم ينطفئ أي مصباح في الشارع.", "context": "Two-clause contrast; tests rhythm and alignment.", "series": "fixture-en", "chapter": 6 },
  { "id": "en-l-04", "source_language": "en", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "test", "source_text": "Everyone said he wouldn't come back, and yet there he was, standing in the doorway.", "reference_arabic": "قال الجميع إنه لن يعود، ومع ذلك كان هناك واقفًا في المدخل.", "context": "Concessive long sentence with a contrastive ending.", "series": "fixture-en", "chapter": 6 },

  { "id": "en-k-01", "source_language": "en", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "It's her.", "reference_arabic": "إنها هي.", "context": "Pronoun resolvable only from the previous bubble.", "series": "fixture-en", "chapter": 3, "character": "heroine" },
  { "id": "en-k-02", "source_language": "en", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "Not yet.", "reference_arabic": "ليس بعد.", "context": "Bare negation; the object is in the previous panel.", "series": "fixture-en", "chapter": 3 },
  { "id": "en-k-03", "source_language": "en", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "You always say that.", "reference_arabic": "دائمًا تقول ذلك.", "context": "Reproach; only the previous bubble shows the repeated phrase.", "series": "fixture-en", "chapter": 6 },
  { "id": "en-k-04", "source_language": "en", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "It's over now.", "reference_arabic": "انتهى الأمر.", "context": "'over' is ambiguous; the following bubble disambiguates.", "series": "fixture-en", "chapter": 6 },

  { "id": "en-m-01", "source_language": "en", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "This is it! The decisive battle!", "reference_arabic": "هذه هي! المعركة الحاسمة!", "context": "Shounen battle declaration.", "series": "fixture-en", "chapter": 4 },
  { "id": "en-m-02", "source_language": "en", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "Remember my name.", "reference_arabic": "تذكّر اسمي.", "context": "Heroic self-introduction.", "series": "fixture-en", "chapter": 4, "character": "protagonist" },
  { "id": "en-m-03", "source_language": "en", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "This technique has never failed me.", "reference_arabic": "هذه التقنية لم تخفق معي قط.", "context": "Shounen confidence statement; the absolute must survive.", "series": "fixture-en", "chapter": 6 },
  { "id": "en-m-04", "source_language": "en", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "I told you I'd come back.", "reference_arabic": "ألم أقل إنني سأعود؟", "context": "Vow callback; tests continuity with the previous chapter.", "series": "fixture-en", "chapter": 6 }
]