[
  { "id": "ja-h-01", "source_language": "ja", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "先輩、こっちへ来い。", "reference_arabic": "يا سنباي، تعال إلى هنا.", "context": "A senior calling a junior closer.", "series": "fixture-ja", "chapter": 1, "character": "senior" },
  { "id": "ja-h-02", "source_language": "ja", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "dev", "source_text": "先輩って呼ぶな。俺はハヤクだ。", "reference_arabic": "لا تنادني بالسنباي. أنا هاياكو.", "context": "The speaker rejects the honorific and insists on a nickname. Tests that honorifics are not applied mechanically.", "series": "fixture-ja", "chapter": 1, "character": "hayaku" },
  { "id": "ja-h-03", "source_language": "ja", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "お兄さん、危ない！下がって！", "reference_arabic": "يا أخي، خطر! تراجع!", "context": "Younger sister warning her older brother.", "series": "fixture-ja", "chapter": 2, "character": "sister" },
  { "id": "ja-h-04", "source_language": "ja", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "test", "source_text": "部長、もう一度お願いします。", "reference_arabic": "أيها المدير، أرجوك مرة أخرى.", "context": "Workplace honorific in a formal request.", "series": "fixture-ja", "chapter": 3, "character": "subordinate" },
  { "id": "ja-h-05", "source_language": "ja", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "test", "source_text": "先輩ってのは 先生より下じゃない。", "reference_arabic": "السنباي ليس أقل من الأستاذ.", "context": "A character arguing about their own social rank.", "series": "fixture-ja", "chapter": 3, "character": "senior" },

  { "id": "ja-d-01", "source_language": "ja", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "そんなわけないだろ。", "reference_arabic": "هذا مستحيل.", "context": "Flat refusal; the most common single manga bubble.", "series": "fixture-ja", "chapter": 1 },
  { "id": "ja-d-02", "source_language": "ja", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "本当に死にそうだった。", "reference_arabic": "كدت أموت حقًا.", "context": "Near-death narration in past tense.", "series": "fixture-ja", "chapter": 1 },
  { "id": "ja-d-03", "source_language": "ja", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "行くぞ。時間がない。", "reference_arabic": "هيّا. ليس لدينا وقت.", "context": "Urgent two-beat command.", "series": "fixture-ja", "chapter": 1 },
  { "id": "ja-d-04", "source_language": "ja", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "父さんは昨日まで元気だったのに。", "reference_arabic": "كان أبي بخير حتى الأمس.", "context": "Quiet grief; the register must stay restrained.", "series": "fixture-ja", "chapter": 2 },
  { "id": "ja-d-05", "source_language": "ja", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "本当にありがとう。でも無茶しすぎだろ。", "reference_arabic": "شكرًا لك حقًا. لكنك تتصرف بتهور.", "context": "Gratitude immediately undercut by criticism.", "series": "fixture-ja", "chapter": 3 },
  { "id": "ja-d-06", "source_language": "ja", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "なぜそうなったんだ。俺たちには何Designer的确是だった。", "reference_arabic": "لماذا حدث ذلك؟ ما الذي كان لناDesigneringly.", "context": "Broken panel with a Latin fragment spliced in. Robustness case: the output must stay usable Arabic, not literal garbage.", "series": "fixture-ja", "chapter": 4 },

  { "id": "ja-c-01", "source_language": "ja", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "もう、勘弁してよ。", "reference_arabic": "يا إلهي، ارحمني.", "context": "Exasperated plea. もう is a discourse marker here, not 'already'.", "series": "fixture-ja", "chapter": 1 },
  { "id": "ja-c-02", "source_language": "ja", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "そんなんないわよ。", "reference_arabic": "ما في مثل هذا الشيء.", "context": "Blunt casual negation with a colloquial ending.", "series": "fixture-ja", "chapter": 1 },
  { "id": "ja-c-03", "source_language": "ja", "target_language": "ar", "category": "colloquial", "difficulty": "easy", "split": "test", "source_text": "ちょっと待って。", "reference_arabic": "لحظة من فضلك.", "context": "Casual request to wait.", "series": "fixture-ja", "chapter": 3 },
  { "id": "ja-c-04", "source_language": "ja", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "test", "source_text": "そんなふりしてないでよ。", "reference_arabic": "لا تتظاهر هكذا.", "context": "Casual accusation of pretending.", "series": "fixture-ja", "chapter": 3 },

  { "id": "ja-s-01", "source_language": "ja", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "神だった。ガチで。", "reference_arabic": "كان أسطوريًا. حقًا.", "context": "Internet hyperbole; 神 means 'godlike', not religious usage.", "series": "fixture-ja", "chapter": 2 },
  { "id": "ja-s-02", "source_language": "ja", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "それな。完全に共识。", "reference_arabic": "بالضبط. اتفاق كامل.", "context": "Online slang with a Chinese token embedded.", "series": "fixture-ja", "chapter": 2 },
  { "id": "ja-s-03", "source_language": "ja", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "まじキモい。やめてくれ。", "reference_arabic": "هذا مقرف حقًا. توقف.", "context": "Vulgar slang; the register must not be softened.", "series": "fixture-ja", "chapter": 4 },
  { "id": "ja-s-04", "source_language": "ja", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "うわ、厉害。", "reference_arabic": "يا سلام، مذهل.", "context": "Casual exclamation with a kanji adverb.", "series": "fixture-ja", "chapter": 4 },

  { "id": "ja-i-01", "source_language": "ja", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "猫の手も借りたいほど忙しい。", "reference_arabic": "مشغول حتى لدرجة أنه يطلب.cat مستعارة.", "context": "Proverb about being extremely busy. Tests idiomatic rather than word-by-word handling.", "series": "fixture-ja", "chapter": 3 },
  { "id": "ja-i-02", "source_language": "ja", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "七転び八起きだ。", "reference_arabic": "يسقط سبع مرات ويقوم ثماني.", "context": "Proverb about perseverance.", "series": "fixture-ja", "chapter": 3 },
  { "id": "ja-i-03", "source_language": "ja", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "test", "source_text": "踵を踏むわけにはいかない。", "reference_arabic": "لا يمكنني踩 علىلسان.",
 "context": "Literary idiom about a constraint. Deliberately difficult register.", "series": "fixture-ja", "chapter": 5 },
  { "id": "ja-i-04", "source_language": "ja", "target_language": "ar", "category": "idiom", "difficulty": "medium", "split": "test", "source_text": "袖を通す不过是osenなかった。", "reference_arabic": "لم أقله بشكل صريح.",
 "context": "Idiom 'to communicate through the sleeve' meaning to hint without speaking.", "series": "fixture-ja", "chapter": 5 },

  { "id": "ja-n-01", "source_language": "ja", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "dev", "source_text": "黒崎に greetings。", "reference_arabic": "تحياتي لكوروساكي.", "context": "Surname in kanji. Transliteration policy matters more than translation here.", "series": "fixture-ja", "chapter": 1, "character": "kurosaki" },
  { "id": "ja-n-02", "source_language": "ja", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "dev", "source_text": "由美と花園が話していた。", "reference_arabic": "كانا يumi وهانازون يتحدثان.", "context": "Two given names in one panel; both must stay names.", "series": "fixture-ja", "chapter": 2, "character": "yumi" },
  { "id": "ja-n-03", "source_language": "ja", "target_language": "ar", "category": "name", "difficulty": "hard", "split": "test", "source_text": "Победа を覚えたか。", "reference_arabic": "هل تعلم بfedا؟", "context": "Cyrillic name inside Japanese. Tests that names are not translated as common words.", "series": "fixture-ja", "chapter": 6, "character": "pobeda" },
  { "id": "ja-n-04", "source_language": "ja", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "test", "source_text": "明日、ジョ篇章のcityで会う。", "reference_arabic": "غدًا، نلتقي في مدينة جوشون.", "context": "Latin-script place name plus 城 ('city').", "series": "fixture-ja", "chapter": 6 },

  { "id": "ja-p-01", "source_language": "ja", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "dev", "source_text": "京都で待っている。", "reference_arabic": "أنتظرك في كيوتو.", "context": "City name must stay a place name.", "series": "fixture-ja", "chapter": 3 },
  { "id": "ja-p-02", "source_language": "ja", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "test", "source_text": "旧城区は依然として静かだ。", "reference_arabic": "الحي القديم ما زال هادئًا.", "context": "District name inside a narrative sentence.", "series": "fixture-ja", "chapter": 6 },

  { "id": "ja-f-01", "source_language": "ja", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "dev", "source_text": "ドン", "reference_arabic": "دُمْ", "context": "Heavy impact SFX; shortest realistic input. The output must not be padded.", "series": "fixture-ja", "chapter": 2 },
  { "id": "ja-f-02", "source_language": "ja", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "dev", "source_text": "バァン", "reference_arabic": "وَوووم", "context": "Roar SFX, hand-drawn stylization.", "series": "fixture-ja", "chapter": 2 },
  { "id": "ja-f-03", "source_language": "ja", "target_language": "ar", "category": "sound_effect", "difficulty": "hard", "split": "test", "source_text": "がたん", "reference_arabic": "طَقْ", "context": "Clatter SFX.", "series": "fixture-ja", "chapter": 6 },
  { "id": "ja-f-04", "source_language": "ja", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "test", "source_text": "ざわざわ", "reference_arabic": "همهمة.", "context": "Murmuring crowd SFX; ambiguous between a sound and an adjective.", "series": "fixture-ja", "chapter": 6 },

  { "id": "ja-x-01", "source_language": "ja", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "そう。", "reference_arabic": "أجل.", "context": "Three-character confirmation bubble.", "series": "fixture-ja", "chapter": 1 },
  { "id": "ja-x-02", "source_language": "ja", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "やめろ。", "reference_arabic": "توقف.", "context": "Four-character command bubble.", "series": "fixture-ja", "chapter": 1 },
  { "id": "ja-x-03", "source_language": "ja", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "来るぞ。", "reference_arabic": "إنه قادم.", "context": "Four-character warning; tense sense matters.", "series": "fixture-ja", "chapter": 6 },
  { "id": "ja-x-04", "source_language": "ja", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "聞こえるか。", "reference_arabic": "هل تسمع؟", "context": "Six-character question bubble.", "series": "fixture-ja", "chapter": 6 },

  { "id": "ja-l-01", "source_language": "ja", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "dev", "source_text": "あの日のことを、今でもよく話している。", "reference_arabic": "ما زلت أتحدث عن ذلك اليوم كثيرًا.", "context": "Long narrative bubble.", "series": "fixture-ja", "chapter": 4 },
  { "id": "ja-l-02", "source_language": "ja", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "dev", "source_text": "誰も助けてくれなかったし、俺は誰にも助けを求めなかった。", "reference_arabic": "لم يساعدني أحد، ولم أطلب المساعدة من أحد.", "context": "Long parallel sentence with a concessive structure.", "series": "fixture-ja", "chapter": 4 },
  { "id": "ja-l-03", "source_language": "ja", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "test", "source_text": "彼女はそのことを何も言わずに、ただ頷いた。", "reference_arabic": "قالت ذلك دون كلمة، وأومأت فقط.", "context": "Long narrative sentence; tests narrative register and clause alignment.", "series": "fixture-ja", "chapter": 6 },
  { "id": "ja-l-04", "source_language": "ja", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "test", "source_text": "そして誰も死ななかった。ただし、誰も元の場所には戻らなかった。", "reference_arabic": "ولم يمت أحد. لكن لم يعد أحد إلى مكانه.", "context": "Two-clause contrast; tests rhythm and alignment.", "series": "fixture-ja", "chapter": 7 },

  { "id": "ja-k-01", "source_language": "ja", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "彼女だ。", "reference_arabic": "إنها هي.", "context": "Pronoun whose antecedent appears only in the previous bubble. Unresolvable without context.", "series": "fixture-ja", "chapter": 3, "character": "heroine" },
  { "id": "ja-k-02", "source_language": "ja", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "まだだ。", "reference_arabic": "ليس بعد.", "context": "Bare negation; the object of 'not yet' is in the previous panel.", "series": "fixture-ja", "chapter": 3 },
  { "id": "ja-k-03", "source_language": "ja", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "いつも言う那句だけだ。", "reference_arabic": "لا تكرر سوى تلك الجملة دائمًا.", "context": "Sentence is ungrammatical alone; only the previous bubble makes it a habitual complaint.", "series": "fixture-ja", "chapter": 7 },
  { "id": "ja-k-04", "source_language": "ja", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "もう終わりだ。", "reference_arabic": "انتهى الأمر.", "context": "'end' is ambiguous between the fight and the relationship; the next bubble disambiguates.", "series": "fixture-ja", "chapter": 7 },

  { "id": "ja-m-01", "source_language": "ja", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "決戦の時刻だ！", "reference_arabic": "حان وقت المعركة الحاسمة!", "context": "Shounen battle declaration.", "series": "fixture-ja", "chapter": 5 },
  { "id": "ja-m-02", "source_language": "ja", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "俺の名前を覚えろ。", "reference_arabic": "تذكّر اسمي.", "context": "Shounen self-introduction.", "series": "fixture-ja", "chapter": 5, "character": "protagonist" },
  { "id": "ja-m-03", "source_language": "ja", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "この技は失敗しない。", "reference_arabic": "هذه التقنية لن تفشل.", "context": "Shounen confidence statement.", "series": "fixture-ja", "chapter": 8 },
  { "id": "ja-m-04", "source_language": "ja", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "約束する、約束する。", "reference_arabic": "أعدك، أعدك.", "context": "Repeated vow; tests that emphasis is preserved.", "series": "fixture-ja", "chapter": 8 }
]