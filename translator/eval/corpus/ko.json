[
  { "id": "ko-h-01", "source_language": "ko", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "선배, 드디어 오셨네요.", "reference_arabic": "يا سنباي، جئت أخيرًا.", "context": "A junior addressing a senior with a polite ending.", "series": "fixture-ko", "chapter": 1, "character": "senior" },
  { "id": "ko-h-02", "source_language": "ko", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "형, 무리하지 마.", "reference_arabic": "يا أخي، لا تبالغ.", "context": "Older brother address between men; must not read as romantic.", "series": "fixture-ko", "chapter": 1, "character": "brother" },
  { "id": "ko-h-03", "source_language": "ko", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "누나, 그건 안 돼!", "reference_arabic": "يا أخت، هذا غير مسموح!", "context": "Older sister address between mixed-gender siblings.", "series": "fixture-ko", "chapter": 2, "character": "sister" },
  { "id": "ko-h-04", "source_language": "ko", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "test", "source_text": "저는 선생님님입니다.", "reference_arabic": "أنا الأستاذ.", "context": "Honorific stacking; tests that it is rendered once, not amplified.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-h-05", "source_language": "ko", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "test", "source_text": "형이라고 부르지 마세요.", "reference_arabic": "لا تنادني أخًا.", "context": "Rejecting the address; tests that honorifics are not applied mechanically.", "series": "fixture-ko", "chapter": 3 },

  { "id": "ko-d-01", "source_language": "ko", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "말도 안 돼.", "reference_arabic": "هذا غير معقول.", "context": "Flat denial; the most common manhwa bubble.", "series": "fixture-ko", "chapter": 1 },
  { "id": "ko-d-02", "source_language": "ko", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "진짜 죽을 뻔했어.", "reference_arabic": "كدت أموت حقًا.", "context": "Near-death past tense with a colloquial ending.", "series": "fixture-ko", "chapter": 1 },
  { "id": "ko-d-03", "source_language": "ko", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "빨리 가, 시간이 없어.", "reference_arabic": "اذهب بسرعة، الوقت ضيق.", "context": "Urgent command.", "series": "fixture-ko", "chapter": 1 },
  { "id": "ko-d-04", "source_language": "ko", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "아버지는 어제까지 괜찮으셨어.", "reference_arabic": "كان أبي بخير حتى الأمس.", "context": "Quiet grief with a polite ending; restrained register.", "series": "fixture-ko", "chapter": 2 },
  { "id": "ko-d-05", "source_language": "ko", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "고맙지만, 이건 너무 위험해.", "reference_arabic": "شكرًا لك، لكن هذا خطير جدًا.", "context": "Gratitude plus criticism; tests two-clause alignment.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-d-06", "source_language": "ko", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "무슨 말인지 정확히 말해 봐.", "reference_arabic": "قل بوضوح ما تقصده.", "context": "Impatient demand for clarity.", "series": "fixture-ko", "chapter": 3 },

  { "id": "ko-c-01", "source_language": "ko", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "에휴, 그만 좀.", "reference_arabic": "يا إلهي، كفك.", "context": "Exasperated sigh; 에휴 is an interjection, not 'exhale'.", "series": "fixture-ko", "chapter": 1 },
  { "id": "ko-c-02", "source_language": "ko", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "난 안 그랬는데.", "reference_arabic": "لم أقصد ذلك.", "context": "Casual denial with a colloquial ending.", "series": "fixture-ko", "chapter": 2 },
  { "id": "ko-c-03", "source_language": "ko", "target_language": "ar", "category": "colloquial", "difficulty": "easy", "split": "test", "source_text": "잠깐만요.", "reference_arabic": "لحظة من فضلك.", "context": "Polite request to wait.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-c-04", "source_language": "ko", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "test", "source_text": "그냥 그런 거야.", "reference_arabic": "مجرد هكذا.", "context": "Casual deflection.", "series": "fixture-ko", "chapter": 3 },

  { "id": "ko-s-01", "source_language": "ko", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "이건 실화냐?", "reference_arabic": "هل هذا حقيقي؟", "context": "Internet slang reaction; must sound like the reader, not a textbook.", "series": "fixture-ko", "chapter": 2 },
  { "id": "ko-s-02", "source_language": "ko", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "개멋있다, 인정.", "reference_arabic": "رائع، أعترف بذلك.", "context": "Casual approval slang; the intensifier must not be dropped.", "series": "fixture-ko", "chapter": 2 },
  { "id": "ko-s-03", "source_language": "ko", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "나 진짜 미치겠다.", "reference_arabic": "جننتني حقًا.", "context": "Colloquial frustration; the casual register must survive.", "series": "fixture-ko", "chapter": 4 },
  { "id": "ko-s-04", "source_language": "ko", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "그건 좀 어이없는데.", "reference_arabic": "هذا غير منطقي قليلًا.", "context": "Casual disbelief.", "series": "fixture-ko", "chapter": 4 },

  { "id": "ko-i-01", "source_language": "ko", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "발 벗고 나서다.", "reference_arabic": "خرج عاريًا ليقاتل.",
 "context": "Idiom about going all-out. Tests idiomatic rather than word-by-word handling.", "series": "fixture-ko", "chapter": 2 },
  { "id": "ko-i-02", "source_language": "ko", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "눈칫밥만 먹는다.", "reference_arabic": "لا يرى إلا ما يريد.",
 "context": "Idiom about seeing only what one wants to see.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-i-03", "source_language": "ko", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "test", "source_text": "소리 지르는 나무에 필요한Party 없다.", "reference_arabic": "لا يستحق الأمر كل هذا الضجيج.",
 "context": "Proverb about a noisy tree; tests whether a Latin fragment breaks the sentence.", "series": "fixture-ko", "chapter": 4 },
  { "id": "ko-i-04", "source_language": "ko", "target_language": "ar", "category": "idiom", "difficulty": "medium", "split": "test", "source_text": "말하지 않아도 알겠다.", "reference_arabic": "أفهم حتى دون أن تقول.", "context": "Idiom about reading someone silently.", "series": "fixture-ko", "chapter": 4 },

  { "id": "ko-n-01", "source_language": "ko", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "dev", "source_text": "지호가 고개를 끄덕였다.", "reference_arabic": "أومأ جيهو برأسه.", "context": "Given name plus verb; the name must not be translated as a common word.", "series": "fixture-ko", "chapter": 1, "character": "jiho" },
  { "id": "ko-n-02", "source_language": "ko", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "dev", "source_text": "박서윤이 웃었다.", "reference_arabic": "ابتسمت باك سويون.", "context": "Full Korean name; tests transliteration of the surname.", "series": "fixture-ko", "chapter": 2, "character": "seoyun" },
  { "id": "ko-n-03", "source_language": "ko", "target_language": "ar", "category": "name", "difficulty": "hard", "split": "test", "source_text": "Дракон이 돌아보았다.", "reference_arabic": "التفتالتنين.",
 "context": "Cyrillic name inside Korean. Tests that names are not translated as common words.", "series": "fixture-ko", "chapter": 5, "character": "dragon" },
  { "id": "ko-n-04", "source_language": "ko", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "test", "source_text": "내일 서울에서 만나자.", "reference_arabic": "غدًا، نلتقي في سيول.", "context": "City name inside a casual plan.", "series": "fixture-ko", "chapter": 5 },

  { "id": "ko-p-01", "source_language": "ko", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "dev", "source_text": "부산에서 기다리고 있었다.", "reference_arabic": "كان ينتظر في بوسان.", "context": "City name inside a narrative clause.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-p-02", "source_language": "ko", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "test", "source_text": "그 폐허는 아직 조용하다.", "reference_arabic": "تلك الأنقاض ما زالت هادئة.", "context": "Place description; tests narrative register.", "series": "fixture-ko", "chapter": 5 },

