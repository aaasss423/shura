  { "id": "ko-x-01", "source_language": "ko", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "그래.", "reference_arabic": "حسنًا.", "context": "Single-syllable acknowledgement.", "series": "fixture-ko", "chapter": 1 },
  { "id": "ko-x-02", "source_language": "ko", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "멈춰!", "reference_arabic": "قف!", "context": "Two-syllable command bubble.", "series": "fixture-ko", "chapter": 1 },
  { "id": "ko-x-03", "source_language": "ko", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "도착했어.", "reference_arabic": "وصلنا.", "context": "Short past statement; tense matters.", "series": "fixture-ko", "chapter": 5 },
  { "id": "ko-x-04", "source_language": "ko", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "들었어?", "reference_arabic": "سمعت؟", "context": "Short question bubble.", "series": "fixture-ko", "chapter": 5 },

  { "id": "ko-l-01", "source_language": "ko", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "dev", "source_text": "그날 아무 말도 하지 않고, 문 앞에 서서 오래 서 있었다.", "reference_arabic": "لم يقل شيئًا ذلك اليوم، بل ظل واقفًا أمام الباب طويلًا.", "context": "Long narrative sentence with two clauses.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-l-02", "source_language": "ko", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "dev", "source_text": "아무도 그를帮助하지 않았고, 그는 누구에게도 도움을 청하지 않았다.", "reference_arabic": "لم يساعده أحد، ولم يطلب المساعدة من أحد.", "context": "Long parallel sentence with a stray Chinese token; tests clause alignment and robustness.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-l-03", "source_language": "ko", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "test", "source_text": "비는 자정에 멈췄지만, 거리의 불은 하나도 꺼지지 않았다.", "reference_arabic": "توقف المطر عند منتصف الليل، لكن لم ينطفئ أي مصباح في الشارع.", "context": "Two-clause contrast; tests rhythm and alignment.", "series": "fixture-ko", "chapter": 5 },
  { "id": "ko-l-04", "source_language": "ko", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "test", "source_text": "모두들 그가 돌아오지 않을 거라고 했지만, 그는 문 앞에 서 있었다.", "reference_arabic": "قال الجميع إنه لن يعود، لكنه كان واقفًا عند الباب.", "context": "Concessive long sentence with a contrastive ending.", "series": "fixture-ko", "chapter": 6 },

  { "id": "ko-k-01", "source_language": "ko", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "그녀야.", "reference_arabic": "إنها هي.", "context": "Pronoun resolvable only from the previous bubble.", "series": "fixture-ko", "chapter": 3, "character": "heroine" },
  { "id": "ko-k-02", "source_language": "ko", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "아직 아니야.", "reference_arabic": "ليس بعد.", "context": "Bare negation; the object is in the previous panel.", "series": "fixture-ko", "chapter": 3 },
  { "id": "ko-k-03", "source_language": "ko", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "또 그 말만 하네.", "reference_arabic": "لا تكرر تلك الجملة فقط.", "context": "Reproach; only the previous bubble shows the repeated phrase.", "series": "fixture-ko", "chapter": 6 },
  { "id": "ko-k-04", "source_language": "ko", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "다 끝났어.", "reference_arabic": "انتهى كل شيء.", "context": "'end' is ambiguous; the following bubble disambiguates.", "series": "fixture-ko", "chapter": 6 },

  { "id": "ko-m-01", "source_language": "ko", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "결전의 순간이다!", "reference_arabic": "هذه لحظة المعركة الحاسمة!", "context": "Webtoon battle declaration.", "series": "fixture-ko", "chapter": 4 },
  { "id": "ko-m-02", "source_language": "ko", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "내 이름을 기억해 둬.", "reference_arabic": "تذكّر اسمي.", "context": "Heroic self-introduction.", "series": "fixture-ko", "chapter": 4, "character": "protagonist" },
  { "id": "ko-m-03", "source_language": "ko", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "이 기술은 절대 실패하지 않아.", "reference_arabic": "هذه التقنية لن تفشل أبدًا.", "context": "Webtoon confidence statement.", "series": "fixture-ko", "chapter": 6 },
  { "id": "ko-m-04", "source_language": "ko", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "말했잖아, 내가 온다고.", "reference_arabic": "ألم أقل إنني قادم؟", "context": "Vow callback; tests continuity with the previous chapter.", "series": "fixture-ko", "chapter": 6 }
