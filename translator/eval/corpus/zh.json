[
  { "id": "zh-h-01", "source_language": "zh", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "前辈，你终于来了。", "reference_arabic": "يا سنباي، جئت أخيرًا.", "context": "A junior addressing a senior; the honorific must be respected, not flattened.", "series": "fixture-zh", "chapter": 1, "character": "senior" },
  { "id": "zh-h-02", "source_language": "zh", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "dev", "source_text": "老大，这次听我的。", "reference_arabic": "أيها الزعيم، اتبعني هذه المرة.", "context": "Boss address; 老大 is gang-leader slang, not 'elder brother'.", "series": "fixture-zh", "chapter": 1, "character": "boss" },
  { "id": "zh-h-03", "source_language": "zh", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "dev", "source_text": "先生，您误会了。", "reference_arabic": "أيها 先生، لقد أساءت الفهم.", "context": "Polite correction to a teacher.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-h-04", "source_language": "zh", "target_language": "ar", "category": "honorific", "difficulty": "medium", "split": "test", "source_text": "少爷，老爷在书房等你。", "reference_arabic": "أيها الشاب،老爷 في书房 ينتظرك.", "context": "Servant addressing a young master in period-drama speech.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-h-05", "source_language": "zh", "target_language": "ar", "category": "honorific", "difficulty": "hard", "split": "test", "source_text": "我不是你的前辈，别这么叫我。", "reference_arabic": "لست سنبايك، لا تنادني كذلك.", "context": "Rejecting the honorific; tests that it is not applied mechanically.", "series": "fixture-zh", "chapter": 3 },

  { "id": "zh-d-01", "source_language": "zh", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "别开玩笑了。", "reference_arabic": "لا ت开玩笑.", "context": "Flat dismissal; extremely common bubble.", "series": "fixture-zh", "chapter": 1 },
  { "id": "zh-d-02", "source_language": "zh", "target_language": "ar", "category": "dialogue", "difficulty": "easy", "split": "dev", "source_text": "我真的差点死掉。", "reference_arabic": "كدت أموت حقًا.", "context": "Near-death past tense.", "series": "fixture-zh", "chapter": 1 },
  { "id": "zh-d-03", "source_language": "zh", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "快走，时间不多了。", "reference_arabic": "اذهب بسرعة، الوقت ضيق.", "context": "Urgent command.", "series": "fixture-zh", "chapter": 1 },
  { "id": "zh-d-04", "source_language": "zh", "target_language": "ar", "category": "dialogue", "difficulty": "medium", "split": "dev", "source_text": "父亲昨天还好好的。", "reference_arabic": "كان أبي بخير بالأمس.", "context": "Quiet grief; restrained register.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-d-05", "source_language": "zh", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "谢谢你，但这样太冒险了。", "reference_arabic": "شكرًا لك، لكن هذا خطير جدًا.", "context": "Gratitude plus criticism.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-d-06", "source_language": "zh", "target_language": "ar", "category": "dialogue", "difficulty": "hard", "split": "test", "source_text": "你到底想说什么？说明白点。", "reference_arabic": "ماذا تريد أن تقول؟ صرّح.", "context": "Impatient demand for clarity.", "series": "fixture-zh", "chapter": 3 },

  { "id": "zh-c-01", "source_language": "zh", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "别这样啊，怪不好意思的。", "reference_arabic": "لا تفعل هكذا، feels محرجًا.", "context": "Casual embarrassment with a Latin fragment spliced in.", "series": "fixture-zh", "chapter": 1 },
  { "id": "zh-c-02", "source_language": "zh", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "dev", "source_text": "我可没答应过。", "reference_arabic": "لم أوافق قط.", "context": "Casual denial of an agreement.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-c-03", "source_language": "zh", "target_language": "ar", "category": "colloquial", "difficulty": "easy", "split": "test", "source_text": "等一下。", "reference_arabic": "مهلًا.", "context": "Casual request to wait.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-c-04", "source_language": "zh", "target_language": "ar", "category": "colloquial", "difficulty": "medium", "split": "test", "source_text": "你少来这套。", "reference_arabic": "لا تحاول هذه الحيلة.", "context": "Dismissive idiom: 'don't give me that'.", "series": "fixture-zh", "chapter": 3 },

  { "id": "zh-s-01", "source_language": "zh", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "这波操作太秀了。", "reference_arabic": "هذه الحركة كانت مذهلة.", "context": "Gamer slang; 波 and 秀 are internet usage, not their base meanings.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-s-02", "source_language": "zh", "target_language": "ar", "category": "slang", "difficulty": "hard", "split": "dev", "source_text": "我裂开了。", "reference_arabic": "انهارت أعصابي.", "context": "Internet slang for being mentally overwhelmed.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-s-03", "source_language": "zh", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "这也太秀了吧？", "reference_arabic": "هذا مذهل حقًا؟", "context": "Sarcastic gamer reaction.", "series": "fixture-zh", "chapter": 4 },
  { "id": "zh-s-04", "source_language": "zh", "target_language": "ar", "category": "slang", "difficulty": "medium", "split": "test", "source_text": "别cue我。", "reference_arabic": "لا تستفزّني.", "context": "Bilingual internet slang: 'don't cue me'.", "series": "fixture-zh", "chapter": 4 },

  { "id": "zh-i-01", "source_language": "zh", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "他忙得脚不沾地。", "reference_arabic": "مشغول حتى لا يهدأ.",
 "context": "Idiom about being extremely busy. Tests idiomatic rather than word-by-word handling.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-i-02", "source_language": "zh", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "dev", "source_text": "一石二鸟。", "reference_arabic": "عصفوران بحجر واحد.",
 "context": "Four-character idiom meaning 'kill two birds with one stone'.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-i-03", "source_language": "zh", "target_language": "ar", "category": "idiom", "difficulty": "hard", "split": "test", "source_text": "他从来不会脚踏两只船。", "reference_arabic": "لا يلعب على Party.",
 "context": "Idiom about refusing to commit to both sides, with a Latin fragment inside.", "series": "fixture-zh", "chapter": 5 },
  { "id": "zh-i-04", "source_language": "zh", "target_language": "ar", "category": "idiom", "difficulty": "medium", "split": "test", "source_text": "别把话说得太死。", "reference_arabic": "لا تبالغ في الحسم.",
 "context": "Idiom about leaving an option open.", "series": "fixture-zh", "chapter": 5 },

  { "id": "zh-n-01", "source_language": "zh", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "dev", "source_text": "陈默点了一下头。", "reference_arabic": "أومأ تشن مو برأسه.", "context": "Two-character surname plus given name; must stay a name.", "series": "fixture-zh", "chapter": 1, "character": "chen-mo" },
  { "id": "zh-n-02", "source_language": "zh", "target_language": "ar", "category": "name", "difficulty": "hard", "split": "dev", "source_text": "小林正在等她。", "reference_arabic": "小林 كان بانتظارها.", "context": "Surname name plus two verbs; the name must not be translated as a common word.", "series": "fixture-zh", "chapter": 2, "character": "xiaolin" },
  { "id": "zh-n-03", "source_language": "zh", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "test", "source_text": "王二狗从后面追上来。", "reference_arabic": "لحق وان إيرغوان من الخلف.", "context": "Nickname-style name; tests transliteration rather than meaning.", "series": "fixture-zh", "chapter": 4, "character": "wang-ergou" },
  { "id": "zh-n-04", "source_language": "zh", "target_language": "ar", "category": "name", "difficulty": "medium", "split": "test", "source_text": "李老板请我们吃饭。", "reference_arabic": "دعانا老板 لي إلى العشاء.",
 "context": "Surname plus a business honorific.", "series": "fixture-zh", "chapter": 4, "character": "boss-li" },

  { "id": "zh-p-01", "source_language": "zh", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "dev", "source_text": "我们在长安等雨停。", "reference_arabic": "ننتظر توقف المطر في تشانغ آن.", "context": "Historical city name inside a narrative clause.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-p-02", "source_language": "zh", "target_language": "ar", "category": "place", "difficulty": "medium", "split": "test", "source_text": "旧城区还是那么安静。", "reference_arabic": "الحي القديم ما زال هادئًا.", "context": "District name inside a narrative sentence.", "series": "fixture-zh", "chapter": 5 },

  { "id": "zh-f-01", "source_language": "zh", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "dev", "source_text": "砰！", "reference_arabic": "دُمْ!", "context": "Impact SFX as a standalone panel.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-f-02", "source_language": "zh", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "dev", "source_text": "轰隆——", "reference_arabic": "دَوُومُو —",
 "context": "Rumble SFX with an em-dash tail.", "series": "fixture-zh", "chapter": 2 },
  { "id": "zh-f-03", "source_language": "zh", "target_language": "ar", "category": "sound_effect", "difficulty": "hard", "split": "test", "source_text": "咔嚓", "reference_arabic": "طَقْ.",
 "context": "Snap / crack SFX.", "series": "fixture-zh", "chapter": 5 },
  { "id": "zh-f-04", "source_language": "zh", "target_language": "ar", "category": "sound_effect", "difficulty": "medium", "split": "test", "source_text": "哗啦啦", "reference_arabic": "خَشْخَشَة.",
 "context": "Running-water SFX, reduplicated.", "series": "fixture-zh", "chapter": 5 },

  { "id": "zh-x-01", "source_language": "zh", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "嗯。", "reference_arabic": "همم.", "context": "Single-syllable acknowledgement.", "series": "fixture-zh", "chapter": 1 },
  { "id": "zh-x-02", "source_language": "zh", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "dev", "source_text": "住手！", "reference_arabic": "توقف!", "context": "Two-character exclamation.", "series": "fixture-zh", "chapter": 1 },
  { "id": "zh-x-03", "source_language": "zh", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "来了。", "reference_arabic": "وصل.", "context": "Three-character present statement; tense matters.", "series": "fixture-zh", "chapter": 5 },
  { "id": "zh-x-04", "source_language": "zh", "target_language": "ar", "category": "short", "difficulty": "easy", "split": "test", "source_text": "你听见了吗？", "reference_arabic": "هل سمعت ذلك؟", "context": "Short question bubble.", "series": "fixture-zh", "chapter": 5 },

  { "id": "zh-l-01", "source_language": "zh", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "dev", "source_text": "她那天什么也没说，只是站在门口看了很久。", "reference_arabic": "لم تقل شيئًا في ذلك اليوم، بل وقفت عند الباب طويلًا.", "context": "Long narrative sentence with two clauses.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-l-02", "source_language": "zh", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "dev", "source_text": "没有人帮他，他也没有向任何人求助。", "reference_arabic": "لم يساعده أحد، ولم يطلب المساعدة من أحد.", "context": "Long parallel sentence; tests clause alignment.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-l-03", "source_language": "zh", "target_language": "ar", "category": "long", "difficulty": "medium", "split": "test", "source_text": "雨在午夜停了，可街上的灯还没有一盏熄灭。", "reference_arabic": "توقف المطر عند منتصف الليل، لكن لم تنطفئ أي مصباح في الشارع.", "context": "Two-clause contrast; tests rhythm and alignment.", "series": "fixture-zh", "chapter": 6 },
  { "id": "zh-l-04", "source_language": "zh", "target_language": "ar", "category": "long", "difficulty": "hard", "split": "test", "source_text": "所有人都说他不会回来，可他偏偏就站在门口。", "reference_arabic": "قال الجميع إنه لن يعود، لكنه كان واقفًا عند الباب.", "context": "Concessive long sentence with a contrastive ending.", "series": "fixture-zh", "chapter": 6 },

  { "id": "zh-k-01", "source_language": "zh", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "是她。", "reference_arabic": "إنها هي.", "context": "Pronoun resolvable only from the previous bubble.", "series": "fixture-zh", "chapter": 3, "character": "heroine" },
  { "id": "zh-k-02", "source_language": "zh", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "dev", "source_text": "还不行。", "reference_arabic": "ليس بعد.", "context": "Bare negation; the object is in the previous panel.", "series": "fixture-zh", "chapter": 3 },
  { "id": "zh-k-03", "source_language": "zh", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "你怎么又这么说。", "reference_arabic": "لماذا تقول ذلك مرة أخرى.", "context": "Reproach; only the previous bubble shows the repeated phrase.", "series": "fixture-zh", "chapter": 6 },
  { "id": "zh-k-04", "source_language": "zh", "target_language": "ar", "category": "context_dependent", "difficulty": "hard", "split": "test", "source_text": "都结束了。", "reference_arabic": "انتهى كل شيء.", "context": "'end' is ambiguous; the following bubble disambiguates.", "series": "fixture-zh", "chapter": 6 },

  { "id": "zh-m-01", "source_language": "zh", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "决战的时刻到了！", "reference_arabic": "حان وقت المعركة الحاسمة!", "context": "Xianxia battle declaration.", "series": "fixture-zh", "chapter": 4 },
  { "id": "zh-m-02", "source_language": "zh", "target_language": "ar", "category": "manga_expression", "difficulty": "medium", "split": "dev", "source_text": "记住我的名字。", "reference_arabic": "تذكّر اسمي.", "context": "Heroic self-introduction.", "series": "fixture-zh", "chapter": 4, "character": "protagonist" },
  { "id": "zh-m-03", "source_language": "zh", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "这一招，我从不失手。", "reference_arabic": "هذه الحركة لا تخفق معي أبدًا.", "context": "Xianxia confidence statement.", "series": "fixture-zh", "chapter": 6 },
  { "id": "zh-m-04", "source_language": "zh", "target_language": "ar", "category": "manga_expression", "difficulty": "hard", "split": "test", "source_text": "我说过，我会回来。", "reference_arabic": "لقد قلت إنني سأعود.", "context": "Vow callback; tests continuity with the previous chapter.", "series": "fixture-zh", "chapter": 6 }
]