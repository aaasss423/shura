# Translation Platform — local env template
# Copy to .env and fill real values. NEVER commit a filled .env.
#
# API keys belong in the environment (DEEPL_API_KEY) or in the encrypted
# runtime store written by the UI's Settings tab. Do not put a key here and
# commit it — .env is git-ignored, but a key in source control is a leak.

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# --- Engine selection ---
# Registered engine ids: mymemory | deepl | echo (echo is offline-only)
# Leave unset to use deepl when DEEPL_API_KEY is present, mymemory otherwise.
TRANSLATION_ENGINE=
# Per-source-language routing, e.g. ja=deepl,zh=deepl,ko=deepl
TRANSLATION_ENGINE_ROUTES=
# Ordered engines to try when the routed/default engine fails.
# Defaults to mymemory when a DeepL key is present.
TRANSLATION_ENGINE_FALLBACKS=
# Circuit breaker: consecutive failures before an engine is skipped.
ENGINE_FAILURE_THRESHOLD=2
ENGINE_COOLDOWN_MS=60000

# --- MyMemory engine (free tier, no key required) ---
MYMEMORY_ENDPOINT=https://api.mymemory.translated.net/get
# Optional: raises anonymous rate limits. Keep out of source control.
MYMEMORY_CONTACT_EMAIL=
# Hard cap enforced by the MyMemory API. Segmentation respects it.
MYMEMORY_MAX_QUERY_CHARS=480
MYMEMORY_MIN_INTERVAL_MS=250

# --- DeepL engine (requires a key) ---
# Leave empty to run with MyMemory only. DeepL is reported as
# "unavailable: DEEPL_API_KEY is not set" and routing skips it.
DEEPL_API_KEY=
# Free plan endpoint. DeepL Pro uses https://api.deepl.com/v2/translate
DEEPL_ENDPOINT=https://api-free.deepl.com/v2/translate
DEEPL_TIMEOUT_MS=15000
# DeepL accepts up to 128 KiB per request; this stays well below that.
DEEPL_MAX_CHARS=4000
DEEPL_MIN_INTERVAL_MS=100
# default | more | less | prefer_more | prefer_less (empty = API default)
DEEPL_FORMALITY=

# --- Timeouts (milliseconds) ---
REQUEST_TIMEOUT_MS=15000
CHAPTER_DEADLINE_MS=120000

# --- Retry ---
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=300
RETRY_MAX_DELAY_MS=4000
RETRY_JITTER_RATIO=0.2

# --- Cache ---
CACHE_ENABLED=true
CACHE_DIR=.cache
CACHE_TTL_MS=2592000000
CACHE_MAX_ENTRIES=5000

# --- Chapter translation ---
CHAPTER_MAX_SEGMENTS=400
CHAPTER_CONCURRENCY=3
CHAPTER_SEGMENT_MAX_CHARS=450
CHAPTER_FAILURE_POLICY=partial

# --- Offline test engine ---
# The echo engine fabricates output and is for tests only.
TRANSLATION_ALLOW_ECHO_ENGINE=false

# --- Logging ---
LOG_LEVEL=info