<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon.

  The manifest had no android:icon at all, so the app shipped with whatever the
  launcher invented for it: on several launchers that is nothing at all, which
  reads to the user as "it did not install" rather than as "I cannot find it".

  A vector, so there is one file instead of a density ladder, and it resolves on
  every API level the app supports (21+).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/shura_primary"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,30h52v9h-52z M28,49h52v9h-52z M28,68h34v9h-34z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M70,64l10,10l10,-10l4,4l-14,14l-14,-14z" />
</vector>
