<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/label_server" android:textStyle="bold" />
        <EditText android:id="@+id/server_url" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textUri"
            android:importantForAutofill="no" android:autofillHints="" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/label_engine" android:textStyle="bold" />
        <EditText android:id="@+id/engine_id" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"
            android:hint="@string/hint_server_route" android:importantForAutofill="no" android:autofillHints="" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/label_source" android:textStyle="bold" />
        <EditText android:id="@+id/source_language" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"
            android:hint="@string/hint_autodetect" android:importantForAutofill="no" android:autofillHints="" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/label_timeout" android:textStyle="bold" />
        <EditText android:id="@+id/timeout_ms" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number"
            android:importantForAutofill="no" android:autofillHints="" />

        <Button android:id="@+id/save" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/action_save" />

        <TextView android:id="@+id/settings_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
